{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chinese-poetry",
  "version": "0.1.0",
  "identifier": "cn.shi-ci.poetry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "诗词",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#fdf2f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/poetry_index.db"],
    "copyright": "MIT",
    "category": "Education",
    "shortDescription": "中文诗词阅读",
    "longDescription": "基于 chinese-poetry 数据源的离线中文诗词阅读器"
  }
}
